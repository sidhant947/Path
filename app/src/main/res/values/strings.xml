    <string name="desc_aggressive_battery_saving">Android manufacturers frequently shut down background pedometers. Follow these steps for your device to ensure continuous tracking:</string>
    <string name="device_google_pixel">Google Pixel</string>
    <string name="desc_google_pixel">Settings &gt; Apps &gt; Path &gt; Battery &gt; Select \'Unrestricted\'.</string>
    <string name="device_samsung">Samsung</string>
    <string name="desc_samsung">Settings &gt; Battery &gt; Background usage limits &gt; Ensure Path is not in sleeping apps list.</string>
    <string name="device_xiaomi">Xiaomi / Redmi</string>
    <string name="desc_xiaomi">App Info &gt; Battery Saver &gt; Select \'No restrictions\'.</string>
    <string name="device_oneplus">OnePlus</string>
    <string name="desc_oneplus">Settings &gt; Apps &gt; App management &gt; Path &gt; Battery usage &gt; Enable \'Allow background activity\'.</string>
